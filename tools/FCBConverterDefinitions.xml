						<Condition action="Contains" value="Dimensions" />
						<Condition action="ContainsCI" value="offset" />
						<Condition action="ContainsCI" value="position" />
						<Condition action="Contains" value="Pos" />
						<Condition action="ContainsCI" value="rotation" />
						<Condition action="Contains" value="Orientation" />
						<Condition action="Contains" value="Direction" />
						<Condition action="Contains" value="Multiplier" />
						<Condition action="ContainsCI" value="vector" />
						<Condition action="ContainsCI" value="color" />
						<Condition action="ContainsCI" value="clr" />
						<Condition action="ContainsCI" value="BBoxMin" />
						<Condition action="ContainsCI" value="BBoxMax" />
						<Condition action="ContainsCI" value="BBMin" />
						<Condition action="ContainsCI" value="BBMax" />
						<Condition action="StartsWith" value="vec" />
						<Condition action="Contains" value="value" />
					</ConditionArray>
				</ConditionArray>
			</ConditionList>

			<!--vec2-->
			<ConditionList type="Vector2" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="16" />
					<ConditionArray type="or">
						<Condition action="Contains" value="offset" />
						<Condition action="Contains" value="position" />
						<Condition action="Contains" value="rotation" />
						<Condition action="Contains" value="vector" />
						<Condition action="StartsWith" value="vec" />
						<Condition action="Contains" value="value" />
					</ConditionArray>
