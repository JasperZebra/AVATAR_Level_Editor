			<!--hid_DbRefT-->
			<!--because this exists as Hash32 and also as String-->
			<ConditionList type="ComputeHash32" forceType="false" action="FindInDictionarySkip">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="8" />
					<Condition action="ExactName" value="hid_DbRefT" />
				</ConditionArray>
			</ConditionList>
			<ConditionList type="String" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="8" type="not" />
					<Condition action="ByteLast" value="00" />
					<Condition action="ExactName" value="hid_DbRefT" />
				</ConditionArray>
			</ConditionList>


			<!--Enum-->
			<ConditionList type="Enum" forceType="false">
				<ConditionArray type="and">
