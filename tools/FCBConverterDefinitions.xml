					<Condition action="StartsWithType" value="sel" />
				</ConditionArray>
			</ConditionList>

			<!--UInt32-->
			<ConditionList type="UInt32" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="8" />
					<ConditionArray type="or">
						<Condition action="StartsWithType" value="snd" />
						<Condition action="StartsWithType" value="sndtp" />
						<Condition action="StartsWith" value="SoundId" />
					</ConditionArray>
				</ConditionArray>
			</ConditionList>

			<!--Int32-->
			<ConditionList type="Int32" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="8" />
					<ConditionArray type="or">
						<ConditionArray type="and">
							<Condition action="ByteLast" value="00" />
							<Condition action="StartsWithType" value="f" type="not" />
							<Condition action="StartsWith" value="text_" type="not" />
							<Condition action="ContainsCI" value="name" type="not" />
							<Condition action="ExactName" value="String" type="not" />
							<Condition action="ExactName" value="shader" type="not" />
						</ConditionArray>
						<ConditionArray type="or">
							<Condition action="Contains" value="locid" />
							<Condition action="StartsWith" value="loc" />
							<Condition action="StartsWithType" value="i" />
							<Condition action="StartsWithType" value="u" />
							<Condition action="ExactName" value="Id" />
						</ConditionArray>
					</ConditionArray>
				</ConditionArray>
			</ConditionList>

			<!--Int16-->
			<ConditionList type="Int16" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="4" />
					<Condition action="StartsWithType" value="f" type="not" />
				</ConditionArray>
			</ConditionList>

			<!--String-->
			<ConditionList type="String" forceType="false">
				<ConditionArray type="or">
					<ConditionArray type="and">
						<Condition action="ByteLen" value=">4" />
						<Condition action="ByteLast" value="00" />
						<Condition action="Regex" value="^[a-zA-Z0-9_.:\/\-\x20\\\(\)]+$" />
					</ConditionArray>
					<Condition action="StartsWith" value="text_" />
					<!-- <Condition action="StartsWithType" value="s" /> -->
				</ConditionArray>
			</ConditionList>

			<!--hash64-->
			<ConditionList type="Hash64" forceType="false">
				<ConditionArray type="and">
					<ConditionArray type="or">
						<ConditionArray type="and">
							<Condition action="ByteLen" value="16" />
							<Condition action="RegexBinaryHex" value="^[0-9a-fA-F]{16}$" />
							<Condition action="ExactValue" value="0000000000000000" type="not" />
							<Condition action="ExactValue" value="ffffffffffffffff" type="not" />
							<Condition action="StartsWith" value="vec" type="not" />
							<Condition action="ContainsCI" value="value" type="not" />
						</ConditionArray>
						<Condition action="ExactName" value="hash" />
						<Condition action="ExactName" value="kitidGraphicKit" />
					</ConditionArray>
					<ConditionArray type="and">
						<Condition action="ByteLast" value="00" type="not" />
						<Condition action="ContainsCI" value="layerid" type="not" />
						<Condition action="StartsWithType" value="ent" type="not" />
						<Condition action="ExactName" value="GameElementId" type="not" />
						<Condition action="EndsWith" value="Id" type="not" />
						<Condition action="ExactName" value="kitidGraphicKit" type="not" />
					</ConditionArray>
				</ConditionArray>
			</ConditionList>

			<!--id64-->
			<ConditionList type="Id64" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="16" />
					<Condition action="RegexBinaryHex" value="^[0-9a-fA-F]{16}$" />
					<Condition action="ExactValue" value="0000000000000000" type="not" />
					<Condition action="ExactValue" value="ffffffffffffffff" type="not" />
					<Condition action="StartsWith" value="vec" type="not" />
					<Condition action="ContainsCI" value="value" type="not" />
				</ConditionArray>
			</ConditionList>

			<!--float32-->
			<ConditionList type="Float32" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="8" />
					<Condition action="RegexBinaryHex" value="^[0-9a-fA-F]{8}$" />
					<ConditionArray type="or">
						<ConditionArray type="and">
							<Condition action="ExactValue" value="00000000" type="not" />
							<Condition action="ExactValue" value="ffffffff" type="not" />
							<Condition action="ByteLast" value="00" type="not" />
						</ConditionArray>
						<Condition action="StartsWithType" value="f" />
						<Condition action="ExactName" value="shader" />
					</ConditionArray>
					<ConditionArray type="or">
						<ConditionArray type="and">
							<Condition action="ContainsCI" value="hid_DTCTH_ClassName" type="not" />
							<Condition action="ContainsCI" value="Name" type="not" />
							<Condition action="ContainsCI" value="BoneID" type="not" />
							<Condition action="Contains" value="Type" type="not" />
							<Condition action="ContainsCI" value="Id" type="not" />
							<Condition action="Contains" value="sDetail" type="not" />
							<Condition action="Contains" value="class" type="not" />
							<Condition action="Contains" value="type" type="not" />
							<Condition action="ExactName" value="shader" type="not" />
							<!-- Hash-typed naming-convention prefixes — these are never floats -->
							<Condition action="StartsWith" value="ps" type="not" />
							<Condition action="StartsWith" value="mix" type="not" />
							<Condition action="StartsWith" value="matimp" type="not" />
							<Condition action="StartsWith" value="aiws" type="not" />
							<Condition action="StartsWith" value="file" type="not" />
							<Condition action="StartsWith" value="tex" type="not" />
							<Condition action="StartsWith" value="obj" type="not" />
							<Condition action="ContainsCI" value="Bone" type="not" />
							<Condition action="ContainsCI" value="Brain" type="not" />
							<Condition action="Contains" value="FX" type="not" />
							<Condition action="Contains" value="Tag" type="not" />
							<Condition action="Contains" value="Modifier" type="not" />
						</ConditionArray>
						<Condition action="StartsWithType" value="f" />
						<Condition action="Contains" value="Duration" />
						<Condition action="Contains" value="Multiplier" />
						<Condition action="Contains" value="Distance" />
					</ConditionArray>
				</ConditionArray>
			</ConditionList>

			<!-- ComputeHash32 for generic names that may have values ending in 0x00 -->
			<!-- ByteLen guard prevents FindInDictionarySkip from crashing on short fields -->
			<ConditionList type="ComputeHash32" forceType="false" action="FindInDictionarySkip">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="8" />
					<ConditionArray type="or">
						<Condition action="ExactName" value="Name" />
						<Condition action="ExactName" value="Type" />
						<Condition action="ExactName" value="Brain" />
						<Condition action="ExactName" value="Item" />
					</ConditionArray>
