			<ConditionList type="Vector4" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="32" />
					<ConditionArray type="or">
						<Condition action="ExactName" value="Value" />
						<Condition action="ExactName" value="Info" />
						<Condition action="ContainsCI" value="offset" />
						<Condition action="ContainsCI" value="position" />
						<Condition action="ContainsCI" value="rotation" />
						<Condition action="ContainsCI" value="vector" />
						<Condition action="StartsWith" value="vec" />
						<Condition action="Contains" value="value" />
