			<ConditionList type="ComputeHash32" forceType="false" action="FindInDictionarySkip">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="8" />
					<Condition action="RegexBinaryHex" value="^[0-9a-fA-F]{8}$" />
					<ConditionArray type="or">
						<ConditionArray type="and">
							<Condition action="ExactValue" value="00000000" type="not" />
							<Condition action="ExactValue" value="ffffffff" type="not" />
							<Condition action="ByteLast" value="00" type="not" />
						</ConditionArray>
						<Condition action="ExactName" value="shader" />
					</ConditionArray>
				</ConditionArray>
			</ConditionList>

			<!--Bool-->
			<ConditionList type="Boolean" forceType="false">
				<ConditionArray type="and">
					<Condition action="ByteLen" value="2" />
					<ConditionArray type="or">
